# Copiez ce fichier en .env et remplissez si necessaire.
# Linux/macOS : cp .env.example .env
# Windows PowerShell : Copy-Item .env.example .env
#
# Le cours fonctionne 100% localement avec Ollama. AUCUNE cle payante requise.

# --- Ollama (obligatoire) ---
# Installation : https://ollama.com
# Lancer le serveur : ollama serve
# Telecharger le modele : ollama pull tinyllama
# URL par defaut (ne pas modifier sauf installation custom)
OLLAMA_URL=http://localhost:11434/v1

# Modele Ollama a utiliser.
# Par defaut : tinyllama (640 Mo, rapide, suffisant pour Rooms 01-04 et 06)
# Recommande pour Room 05 (RAG) : llama3.2:1b (1.3 Go, meilleure qualite)
# Pour changer : ollama pull llama3.2:1b puis MODELE_OLLAMA=llama3.2:1b
MODELE_OLLAMA=tinyllama

# --- Hugging Face (Room 03 uniquement) ---
# Necessaire seulement pour comparer des modeles open source.
# Creez un compte sur https://huggingface.co
# Generez un token dans Settings > Access Tokens
# Permission requise : Read (ou Make calls to Inference Providers)
HF_TOKEN=hf_votre_token_huggingface_ici
